# ------------------------------------
# 1. Standard Python Virtual Environment
# ------------------------------------
# Virtual environment directories
venv/
.venv/
env/
.env/
.env

# Byte-compiled files
*.py[co]
__pycache__/

# ------------------------------------
# 2. Python Distribution/Build Files
# ------------------------------------
# Generated build products from pip/setuptools
build/
dist/
*.egg-info/
.eggs/

# Standard location for editable installs
# This is usually a directory created by setuptools/pip
.mypy_cache/
.pytest_cache/
.tox/
htmlcov/

# ------------------------------------
# 3. C++ / Pybind11 / CMake Build Files
# ------------------------------------
# The C++ build directory (where CMake stores object files, etc.)
# If you are using a dedicated 'build' directory at the root:
# (Note: if you are using 'build' for Python, use 'build_cpp' for C++ instead)
build_cpp/
CMakeCache.txt
CMakeFiles/
Makefile
cmake_install.cmake
install_manifest.txt

# Compiled C/C++ extension modules
# This is the most important one: the actual compiled library file
# This will be in your 'orienteering_solver' folder, e.g.,
# 'orienteering_solver.cpython-310-x86_64-linux-gnu.so'
*.so
*.dylib
*.pyd

# ------------------------------------
# 4. IDE and OS Files (Highly Recommended)
# ------------------------------------
# Visual Studio Code
.vscode/

# PyCharm / IntelliJ
.idea/

# Operating System files
.DS_Store
Thumbs.db

